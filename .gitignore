# ============================================================================
# CozyVTT — Root .gitignore
# Sub-directories (backend/, frontend/) have their own .gitignore for
# project-specific patterns. This file covers anything at the repo root or
# common to both projects.
# ============================================================================

# ---- Environment / Secrets --------------------------------------------------
# Never commit env files. The .example versions are committed; real values are not.
.env
.env.local
.env.production
.env.*.local
*.env.local
# Any other suffix too (.env.test, .env.staging, .env.dev, …) — these hold real
# credentials just as often as .env does. The committed templates are re-included
# below.
.env.*
!.env.example

# ---- Dependencies -----------------------------------------------------------
node_modules/

# ---- Build output -----------------------------------------------------------
dist/
build/

# ---- Logs -------------------------------------------------------------------
logs/
*.log

# ---- IDE / Editor -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---- OS metadata ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker -----------------------------------------------------------------
.docker/

# Local-only Compose overrides: test stacks, machine-specific ports, container
# renames. `docker-compose.override.yml` is picked up automatically by Compose,
# so it is the usual home for local tweaks that must never ship.
# The committed docker-compose.yml and docker-compose.dev.yml are NOT matched.
docker-compose.override.yml
docker-compose.*.local.yml
*.local.yml

# ---- Secrets / keys / certs — never commit private key material ------------
# Broad, repo-wide patterns so a key or alternately-named env file dropped
# anywhere is caught. The committed *.env.example templates are NOT matched
# (they end in .example), so they stay tracked.
*.env
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
# Ignore anything dropped into the certs mount, but keep the placeholder so the
# directory (and its README/.gitkeep) stays in the repo.
nginx/certs/*
!nginx/certs/.gitkeep

# ---- Runtime / user data ----------------------------------------------------
uploads/
backups/

# ---- Test artifacts ---------------------------------------------------------
coverage/
cookies.txt
*.tmp
*.tmp.*

# ---- Generated API docs HTML (rebuild with `npx @redocly/cli build-docs`) ---
# The HTML is a build artifact derived from API_DOCUMENTATION.yaml. Keeping
# it out of git avoids 1.6 MB churn on every spec edit. Self-hosters who
# want to serve it can regenerate it locally — see backend/docs/README.md.
backend/docs/api-docs.html

# ---- Development-only directories -------------------------------------------
# These contain session notes, internal planning docs, and command-output dumps
# that are useful for development but should NOT ship with a public release.
Dev-Docs/
Code&Tests/

# ---- HTTP test request files (developer convenience scripts) ----------------
backend/tests/

# ---- VSCode extension data --------------------------------------------------
.VSCodeCounter/

# ---- Claude Code local settings ---------------------------------------------
.claude/
