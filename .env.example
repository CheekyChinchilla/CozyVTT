# ==============================================
# CozyVTT Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ----------------------------------------------
# Database Configuration
# ----------------------------------------------
DATABASE_NAME=cozyvtt
DATABASE_USER=cozyvtt

# Generate a strong password: openssl rand -hex 16
# A production instance refuses to start while this is still the placeholder.
DATABASE_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Assembled from the above — update if you change DATABASE_PASSWORD
DATABASE_URL=postgresql://cozyvtt:CHANGE_ME_TO_SECURE_PASSWORD@database:5432/cozyvtt

# ----------------------------------------------
# Application
# The Docker setup sets both of these itself (production, port 4000) and does
# not read them from here; they matter only to an install without Docker.
# The instance's name is not set here: it is set in the setup wizard and in
# Admin > Settings, and shows in the browser tab and in emails.
# ----------------------------------------------
NODE_ENV=production
PORT=4000

# ----------------------------------------------
# Security Secrets
# REQUIRED — generate both with: openssl rand -hex 32
# In production the server refuses to start on a placeholder value, or on a
# SESSION_SECRET shorter than 32 characters.
# ----------------------------------------------
SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_32_CHARS_MIN

# Optional. The setup wizard asks for a one-time setup token, so a stranger who
# finds a fresh instance first cannot make themselves its administrator. Leave
# this unset and the backend prints a token in its log at start
# (docker compose logs backend); set it to choose the token yourself. It has no
# use once setup has run.
# SETUP_TOKEN=

# ----------------------------------------------
# Ports
# Change if 80/443 are already in use on your host (e.g. you have another web server).
# If you use an external reverse proxy (Traefik, Caddy, Cloudflare Tunnel, etc.)
# remove the nginx service from docker-compose.yml instead.
# ----------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------------------------
# CORS & Domain
# Set to your public-facing domain in production.
# Example: https://vtt.myserver.com
# ----------------------------------------------
CORS_ORIGIN=http://localhost

# Where the browser should reach the backend, baked in when the frontend is
# built. Leave both EMPTY unless you know you need them: empty means the page
# asks its own address, and the bundled nginx forwards /api/ and /socket.io/ to
# the backend. Set them only if the backend answers on a different address from
# the one people type in, for example https://api.example.com.
VITE_API_URL=
VITE_SOCKET_URL=

# Allowed hostnames for the Vite dev server (comma-separated)
# Only needed in development; not used by production builds.
VITE_ALLOWED_HOSTS=

# ----------------------------------------------
# SMTP — Optional (required for password reset and invitation emails)
# Leave blank to disable email. Admin can still reset passwords manually.
# ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CozyVTT <noreply@yourdomain.com>
# Set to true for port 465 (TLS); false for port 587 (STARTTLS)
SMTP_SECURE=false
# URL used in email links (password reset, invitations, etc.)
# Optional — defaults to CORS_ORIGIN if not set. Only needed if your email links
# should point to a different address than CORS_ORIGIN.
# APP_URL=https://yourdomain.com

# ----------------------------------------------
# File Upload Limits (in MB)
# Applied by `docker compose up -d`, which re-reads this file (a plain
# `docker compose restart` does not); no rebuild needed. Invalid values fall
# back to the defaults below and are logged as a warning at startup.
# ----------------------------------------------
MAX_MAP_SIZE_MB=50
MAX_TOKEN_SIZE_MB=5
MAX_AUDIO_SIZE_MB=20
MAX_AVATAR_SIZE_MB=2
MAX_DOCUMENT_SIZE_MB=50

# Where the Admin Dashboard writes instance backups, on an install WITHOUT
# Docker. Default: a backups folder in the backend's working directory, beside
# uploads/ and never inside it (a backup holds every credential). The Docker
# setup keeps them at backend/backups on the host and does not read this;
# change the backups volume in docker-compose.override.yml instead.
# BACKUP_DIR=backups

# Request body cap for the bundled Nginx (client_max_body_size).
# Must be >= the largest MAX_*_SIZE_MB above plus ~5 MB of multipart overhead,
# or uploads fail with HTTP 413 before reaching the API.
# Example: MAX_MAP_SIZE_MB=250 -> NGINX_MAX_BODY_SIZE=255M
# A Universal VTT import carries its picture as base64 text, about 4/3 of its
# size, and CozyVTT accepts such a file up to MAX_MAP_SIZE_MB x 4/3 + 8 MB for
# walls and lights. To let every one of those through, use MAX_MAP_SIZE_MB x 4/3 + 10.
# Example: MAX_MAP_SIZE_MB=50 -> NGINX_MAX_BODY_SIZE=76M
#
# If you use an EXTERNAL proxy (Traefik, Caddy, host Nginx, Cloudflare Tunnel)
# you must raise its body limit yourself, because this variable only configures
# the bundled Nginx. Campaign imports also need their own rule there:
# /api/campaigns/import needs a body limit of at least 505 MB and about 300
# seconds to answer (see "Minimum proxy requirements" in docs/DEPLOYMENT.md).
# Note that Cloudflare-proxied requests (Tunnels included) are capped at 100 MB
# on Free/Pro plans regardless of these settings.
NGINX_MAX_BODY_SIZE=55M

# ----------------------------------------------
# Session Timeouts (in milliseconds)
# Whole numbers only, such as 3600000: a value with a unit ("8h") or any
# other text falls back to the default, with a warning in the backend log.
# ----------------------------------------------
# How long until an idle session expires (default: 1 hour)
SESSION_MAX_AGE=3600000
# How long a "remember me" session lasts (default: 30 days). This is also the
# longest any sign-in lasts, however active: after it, everyone signs in again.
REMEMBER_ME_MAX_AGE=2592000000

# ----------------------------------------------
# Rate Limiting
# ----------------------------------------------
# Maximum requests per minute to /api/* endpoints (per IP). A whole number;
# anything else falls back to 300 with a warning in the backend log.
# Signing in has a separate, stricter limit: 5 wrong passwords per 15 minutes
# per address (a reset link that no longer works, and a wrong password or code
# when changing two-factor settings, count too; a correct sign-in never does),
# and 10 wrong passwords per hour per account from every address together
# (noted in Admin > Activity). The two-factor code asked for at sign-in has its
# own limit: 5 wrong codes per 15 minutes per address, and 5 per account.
RATE_LIMIT_MAX_REQUESTS=300
# Asset uploads per minute per user (default: 30)
# ASSET_UPLOAD_RATE_LIMIT=30
# Whole-campaign archives per hour per user (default: 20). Counted apart for
# previewing an import, importing and exporting, so 20 of each; each user can
# also run only one of these at a time. Asset uploads are not counted here.
# CAMPAIGN_ARCHIVE_RATE_LIMIT=20

# ----------------------------------------------
# Logging
# ----------------------------------------------
# debug | info | warn | error (default: info in production, debug in development)
# LOG_LEVEL=info
