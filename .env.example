# ==============================================
# CozyVTT Environment Configuration
# ==============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ----------------------------------------------
# Database Configuration
# ----------------------------------------------
DATABASE_NAME=cozyvtt
DATABASE_USER=cozyvtt

# Generate a strong password: openssl rand -hex 16
DATABASE_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Assembled from the above — update if you change DATABASE_PASSWORD
DATABASE_URL=postgresql://cozyvtt:CHANGE_ME_TO_SECURE_PASSWORD@database:5432/cozyvtt

# ----------------------------------------------
# Application
# ----------------------------------------------
NODE_ENV=production
PORT=4000

# ----------------------------------------------
# Security Secrets
# REQUIRED — generate both with: openssl rand -hex 32
# Using placeholder values in production causes the server to refuse to start.
# ----------------------------------------------
SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_32_CHARS_MIN

# ----------------------------------------------
# Ports
# Change if 80/443 are already in use on your host (e.g. you have another web server).
# If you use an external reverse proxy (Traefik, Caddy, Cloudflare Tunnel, etc.)
# remove the nginx service from docker-compose.yml instead.
# ----------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# ----------------------------------------------
# CORS & Domain
# Set to your public-facing domain in production.
# Example: https://vtt.myserver.com
# ----------------------------------------------
CORS_ORIGIN=http://localhost

# Vite build-time URL (leave empty to use relative URLs via proxy)
VITE_API_URL=
VITE_SOCKET_URL=

# Allowed hostnames for the Vite dev server (comma-separated)
# Only needed in development; not used by production builds.
VITE_ALLOWED_HOSTS=

# ----------------------------------------------
# SMTP — Optional (required for password reset and invitation emails)
# Leave blank to disable email. Admin can still reset passwords manually.
# ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CozyVTT <noreply@yourdomain.com>
# Set to true for port 465 (TLS); false for port 587 (STARTTLS)
SMTP_SECURE=false
# URL used in email links (password reset, invitations, etc.)
# Optional — defaults to CORS_ORIGIN if not set. Only needed if your email links
# should point to a different address than CORS_ORIGIN.
# APP_URL=https://yourdomain.com

# ----------------------------------------------
# File Upload Limits (in MB)
# Applied on restart — no rebuild needed. Invalid values fall back to the
# defaults below and are logged as a warning at startup.
# ----------------------------------------------
MAX_MAP_SIZE_MB=50
MAX_TOKEN_SIZE_MB=5
MAX_AUDIO_SIZE_MB=20
MAX_AVATAR_SIZE_MB=2

# Request body cap for the bundled Nginx (client_max_body_size).
# Must be >= the largest MAX_*_SIZE_MB above plus ~5 MB of multipart overhead,
# or uploads fail with HTTP 413 before reaching the API.
# Example: MAX_MAP_SIZE_MB=250 -> NGINX_MAX_BODY_SIZE=255M
#
# If you use an EXTERNAL proxy (Traefik, Caddy, host Nginx, Cloudflare Tunnel)
# you must raise its body limit yourself — this variable only configures the
# bundled Nginx. Note that Cloudflare-proxied requests (Tunnels included) are
# capped at 100 MB on Free/Pro plans regardless of these settings.
NGINX_MAX_BODY_SIZE=55M

# ----------------------------------------------
# Session Timeouts (in milliseconds)
# ----------------------------------------------
# How long until an idle session expires (default: 1 hour)
SESSION_MAX_AGE=3600000
# How long a "remember me" session lasts (default: 30 days)
REMEMBER_ME_MAX_AGE=2592000000

# ----------------------------------------------
# Rate Limiting
# ----------------------------------------------
# Maximum requests per minute to /api/* endpoints (per IP)
# Auth endpoints have a separate, stricter limit (5 per 15 minutes).
RATE_LIMIT_MAX_REQUESTS=300

# ----------------------------------------------
# Logging
# ----------------------------------------------
# debug | info | warn | error (default: info in production, debug in development)
# LOG_LEVEL=info
