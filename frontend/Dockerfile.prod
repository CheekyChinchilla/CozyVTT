# Production Dockerfile — builds the React SPA
# Output: frontend/dist/ (consumed by the backend static middleware or an Nginx container)
FROM node:26-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Build args allow injecting the production API URL at build time
ARG VITE_API_URL
ARG VITE_SOCKET_URL

RUN npm run build

# Serve via Nginx (lightweight serving of built static files). nginx's stable
# line, the same as the proxy's in docker-compose.yml; move both together.
FROM nginx:1.30-alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html

# The Content-Security-Policy has to allow whatever origin this bundle was
# built to talk to, or an instance whose backend lives on another host loads a
# page that cannot reach its API. Both come from the same build args the bundle
# itself is compiled with, so the policy cannot drift from the configuration.
ARG VITE_API_URL
ARG VITE_SOCKET_URL

COPY security-headers.conf /etc/nginx/security-headers.conf.template
RUN CSP_CONNECT_EXTRA="$(printf '%s %s' "${VITE_API_URL}" "${VITE_SOCKET_URL}" | tr -s ' ' | sed 's/^ *//; s/ *$//')" \
    && CSP_CONNECT_EXTRA="${CSP_CONNECT_EXTRA:+ $CSP_CONNECT_EXTRA}" \
    && export CSP_CONNECT_EXTRA \
    && envsubst '${CSP_CONNECT_EXTRA}' < /etc/nginx/security-headers.conf.template > /etc/nginx/security-headers.conf \
    && rm /etc/nginx/security-headers.conf.template

# Nginx config: serve the SPA. /api and /socket.io are the reverse proxy's job.
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
