# Production Dockerfile — builds the React SPA
# Output: frontend/dist/ (consumed by the backend static middleware or an Nginx container)
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Build args allow injecting the production API URL at build time
ARG VITE_API_URL
ARG VITE_SOCKET_URL

RUN npm run build

# Serve via Nginx (lightweight serving of built static files)
FROM nginx:alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx config: serve SPA, forward /api and /socket.io to backend
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
