# Production Dockerfile — builds the React SPA
# Output: frontend/dist/, served by the nginx stage below
FROM node:26-alpine AS builder

WORKDIR /app

COPY package*.json .npmrc ./
RUN npm ci

COPY . .

RUN npm run build

# Serve via Nginx (lightweight serving of built static files). nginx's stable
# line, the same as the proxy's in docker-compose.yml; move both together.
FROM nginx:1.30-alpine AS production

COPY --from=builder /app/dist /usr/share/nginx/html

# The page's security headers, included by every location in nginx.conf.
COPY security-headers.conf /etc/nginx/security-headers.conf

# Nginx config: serve the SPA. /api and /socket.io are the reverse proxy's job.
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
