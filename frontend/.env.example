# CozyVTT Frontend Environment Variables

# API base URL and WebSocket URL for the backend.
#
# Leave BOTH empty for local development. The Vite dev server then proxies
# /api and /socket.io to the backend (http://localhost:4000) on the SAME
# origin as the app — which is also how Docker and production serve everything
# (a single origin behind Nginx).
#
# Do NOT hardcode http://localhost:4000 here: that makes asset thumbnail
# <img> requests cross-origin, and the backend's Cross-Origin-Resource-Policy
# blocks cross-origin resource loads — so asset previews silently fail to load
# even though the rest of the app works. Only set these to an absolute URL if
# the backend truly runs on a different origin you control CORS/CORP for.
VITE_API_URL=
VITE_SOCKET_URL=

# Environment
VITE_ENV=development
