# ============================================================================
# CozyVTT Frontend — .dockerignore
# The image is built from this folder alone, so this file decides what the build sees.
# ============================================================================

# ---- Dependencies (installed fresh inside the image) ------------------------
node_modules/

# ---- Build output (built inside the image) ----------------------------------
dist/
build/
.vite/

# ---- Environment files ------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env.*.local
# Any other .env.<name> file stays out too, so a stray one never reaches the
# image's layers. The example file is the one exception.
.env.*
!.env.example

# ---- Test artifacts ---------------------------------------------------------
coverage/
src/**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.*
src/setupTests.ts

# ---- Documentation / typecheck reports --------------------------------------
typecheck-output.txt

# ---- Git --------------------------------------------------------------------
.git/
.gitignore

# ---- IDE / Editor / OS ------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- ESLint / Prettier caches -----------------------------------------------
.eslintcache
.prettiercache
