          "id": "me",
          "x": 5,
          "y": 5,
          "controlledBy": "p1"
        },
        {
          "id": "npc",
          "x": 6,
          "y": 5
        }
      ],
      "expectVisible": [
        "me"
      ],
      "samples": [
        {
          "x": 550,
          "y": 1450,
          "tier": "dim"
        },
        {
          "x": 650,
          "y": 1450,
          "tier": "dark"
        }
      ]
    },
