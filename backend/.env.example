# CozyVTT Backend — installs without Docker
# -------------------------------------------------------
# This file is ONLY needed when the backend runs outside
# Docker: "npm run dev" in development, or a manual install
# (docs/DEPLOYMENT.md, "Manual Deployment", which sets
# NODE_ENV=production here).
#
# If you are using Docker (docker compose up -d), configure
# everything in the ROOT .env file instead — do not edit this.
# -------------------------------------------------------
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ----------------------------------------------
# Database — required
# ----------------------------------------------
DATABASE_URL="postgresql://cozyvtt:CHANGE_ME_TO_SECURE_PASSWORD@localhost:5432/cozyvtt"

# ----------------------------------------------
# Application
# ----------------------------------------------
NODE_ENV=development
PORT=4000

# The name emails use while the instance name in Admin > Settings is empty or
# still CozyVTT. Set the name there; this is only a fallback.
# INSTANCE_NAME=CozyVTT

# Where uploaded files are stored, relative to the backend folder (default:
# uploads).
# UPLOAD_DIR=uploads

# Where the Admin Dashboard writes instance backups (default: a backups folder
# beside uploads). It must not be inside the uploads folder: a backup holds
# every credential on the instance.
# BACKUP_DIR=backups

# ----------------------------------------------
# Security Secrets — REQUIRED
# Generate with: openssl rand -hex 32
# In production the server refuses to start on a placeholder value, or on a
# SESSION_SECRET shorter than 32 characters.
# ----------------------------------------------
SESSION_SECRET=CHANGE_ME_TO_RANDOM_STRING_32_CHARS_MIN

# Optional. The setup wizard asks for a one-time setup token. Unset, the backend
# prints one in its log at start; set it to choose the token yourself.
# SETUP_TOKEN=

# ----------------------------------------------
# CORS — set to your frontend origin
# ----------------------------------------------
CORS_ORIGIN=http://localhost:3000

# ----------------------------------------------
# File Upload Limits (MB)
# Applied on restart. Invalid values fall back to these defaults with a
# warning at startup. Any reverse proxy in front must allow request bodies of
# at least the largest value + ~5 MB (bundled Nginx: NGINX_MAX_BODY_SIZE).
# ----------------------------------------------
MAX_MAP_SIZE_MB=50
MAX_TOKEN_SIZE_MB=5
MAX_AUDIO_SIZE_MB=20
MAX_AVATAR_SIZE_MB=2
MAX_DOCUMENT_SIZE_MB=50
# The bundled Nginx's body limit, which the Docker setup passes to the backend
# so it can warn at startup when that is smaller than the largest limit above.
# Leave it unset here: without it the backend takes it that your own proxy is
# in front, and says at startup what that proxy must allow.
# NGINX_MAX_BODY_SIZE=55M

# ----------------------------------------------
# Session Timeouts (milliseconds)
# Whole numbers only; anything else falls back to the default with a warning.
# ----------------------------------------------
SESSION_MAX_AGE=3600000
# Also the longest any sign-in lasts, however active it has been.
REMEMBER_ME_MAX_AGE=2592000000

# ----------------------------------------------
# Rate Limiting
# Requests per minute to /api from one IP address; every address in one IPv6
# /56 network counts as one. A whole number; anything else falls back to 300
# with a warning.
# ----------------------------------------------
RATE_LIMIT_MAX_REQUESTS=300
# Asset uploads per minute per user (default: 30)
# ASSET_UPLOAD_RATE_LIMIT=30
# Whole-campaign archives per hour per user, for each of preview, import and
# export (default: 20)
# CAMPAIGN_ARCHIVE_RATE_LIMIT=20

# ----------------------------------------------
# SMTP — optional (leave blank to disable email)
# Email counts as set up only when SMTP_HOST, SMTP_USER and SMTP_PASS are all
# set. A mail server that needs no login is not supported.
# ----------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The sender emails show: an address your mail server is allowed to send
# from. Left empty, SMTP_USER is used.
SMTP_FROM=CozyVTT <noreply@localhost>
SMTP_SECURE=false
# The address email links point to.
APP_URL=http://localhost:3000
# An older name for APP_URL, read only when APP_URL is not set. Use APP_URL.
# FRONTEND_URL=

# ----------------------------------------------
# Logging
# ----------------------------------------------
# LOG_LEVEL=debug
