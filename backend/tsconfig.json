{
  "compilerOptions": {
    "target": "ES2022",
    // Node's own module rules, as current Node applies them. A file is
    // CommonJS because package.json has no "type", so the output stays
    // CommonJS, and a package's "exports" (and the types it names there) are
    // read. "node20" also lets this CommonJS code require the ES module
    // packages archiver and file-type, as Node 22.12 and later do; "node16"
    // refuses them.
    "module": "node20",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    // A method that replaces one of its base class says so, and one that
    // says so when the base has no such method is an error.
    "noImplicitOverride": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    // The global types every file sees. Others come in only when imported.
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
