{
  "compilerOptions": {
    "target": "ES2022",
    // Node's own module rules, as Node 20 and later apply them. A file is
    // CommonJS because package.json has no "type", so the output stays
    // CommonJS, and a package's "exports" (and the types it names there) are
    // read. "node20" also lets this CommonJS code require the ES module
    // packages archiver, file-type and mathjs; "node16" refuses them.
    "module": "node20",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "typeRoots": ["./node_modules/@types", "./src/types"],
    // file-type's package.json names its types only under "exports". The
    // compiler reads them there, but ts-jest checks the tests with the older
    // "node" resolution, which does not, so it is pointed at them here. This
    // ties the config to the package's layout: check it when file-type moves
    // its files. Only the types are looked up here; Node and Jest load the
    // package's code through its "exports" at run time.
    "paths": {
      "file-type": ["./node_modules/file-type/source/index.d.ts"]
    },
    // The global types every file sees. Others come in only when imported.
    "types": ["node", "jest"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
