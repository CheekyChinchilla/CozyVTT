      "story": [
        {
          "title": "Her work",
          "text": "Dr. Voss teaches ancient history and Near Eastern archaeology at a small New England university. She has led three expeditions to the Middle East, and one trip to a dig site in rural England that she refuses to discuss."
        },
        {
          "title": "What she is like",
          "text": "Sharp-eyed, with ink-stained fingers and an air of mild impatience. Methodical and slow to trust. She holds that knowledge is its own justification, and that hiding from a strange universe helps no one."
        },
        {
          "title": "Professor Crane",
          "text": "Harold Crane was her mentor, and died in circumstances nobody has explained. She first opened one of his books in the university library's locked reading room, and wishes she had not."
        },
        {
          "title": "The English dig",
          "text": "She came back with a scar across her left palm and a scarab amulet of uncertain origin, which she keeps in a locked box. Her journal says only that she saw the outline of something that should not have been there."
        }
      ],
      "contacts": [
        {
          "name": "Dr. Ruth Hollis",
          "role": "Head Librarian, the university",
          "notes": "Trusts her; sometimes sets aside restricted volumes for her to read."
        },
        {
          "name": "Frank Daltrey",
          "role": "Private detective, Worcester",
          "notes": "Has helped her on sensitive matters before. Pragmatic."
        },
        {
          "name": "Sister Agnes",
          "role": "Nurse, St. Mary's Hospital",
          "notes": "Patches her up without asking too many questions."
        }
      ],
      "appearance": {
