      "featuresAndTraits": [
        {
          "name": "Arcane Recovery",
          "description": "Once a day, after a short rest, take back used spell slots totalling up to half her wizard level, rounded up (3 at 5th level), all of them below 6th level."
        },
        {
          "name": "Arcane Tradition: School of Evocation",
          "description": "Her studies centre on spells of raw force and energy."
        },
        {
          "name": "Evocation Savant",
          "description": "Copying an evocation spell into her spellbook costs half the usual gold and time."
        },
        {
          "name": "Sculpt Spells",
          "description": "When she casts an evocation spell, up to 1 + the spell's level creatures she can see are spared: each passes its save, and takes nothing where others take half."
        },
        {
          "name": "Darkvision",
          "description": "Out to 60 feet, dim light looks bright to her and darkness looks dim, though she sees no colours in the dark."
        },
        {
          "name": "Fey Ancestry",
          "description": "Saves to resist being charmed are rolled with advantage, and no magic can send her to sleep."
        },
        {
          "name": "Trance",
          "description": "Four hours of quiet meditation each day rest her as fully as eight hours of sleep."
        },
        {
          "name": "Keen Senses",
          "description": "Perception is one of her trained skills."
        },
        {
          "name": "Elf Weapon Training",
          "description": "Longswords, shortswords, shortbows and longbows are weapons she is proficient with."
        },
        {
          "name": "Cantrip (High Elf)",
          "description": "One more wizard cantrip, cast with Intelligence: Minor Illusion."
        },
        {
          "name": "Shelter of the Faithful",
          "description": "Temples and shrines of her faith heal and shelter her and her party at no charge, though she pays for any spell components."
        }
